# ---------------------------------------------------------------------------
# AI Agent Router — environment (copy to .env and edit)
# Real environment variables always override values in this file.
# ---------------------------------------------------------------------------

# API keys allowed to call the router (header X-API-Key).
# Format: key:agent,key:agent   (":agent" binds the key to that from_agent; omit it for a key that may act as any agent)
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it empty and the GUI creates a strong key on first start. Values starting with "change-me"
# are treated as placeholders (ignored), e.g.  ROUTER_API_KEYS=change-me-opencode-key:opencode
ROUTER_API_KEYS=

# Server
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8080
ROUTER_LOG_LEVEL=INFO
# ROUTER_LOG_FILE=logs/router.log
# ROUTER_CONFIG=C:\path\to\config.yaml
# ROUTER_MCP_REQUIRE_AUTH=true
# ROUTER_ALLOW_ANONYMOUS=false

# xAI / Grok
XAI_API_KEY=
# GROK_MODEL=grok-4.7

# OpenCode server (`opencode serve --port 4096`)
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=

# Cursor bridge webhook (optional)
# CURSOR_WEBHOOK_URL=http://127.0.0.1:9100/cursor

# Keys of destination AIs added in the GUI are stored here as <NAME>_API_KEY, e.g.
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
